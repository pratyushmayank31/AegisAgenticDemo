{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/python ${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_secrets.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/python ${CLAUDE_PROJECT_DIR}/.claude/hooks/quality_check.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(/Users/pmayank/workspace/LdcDemo/.venv/bin/python .claude/hooks/test_protect_secrets.py)",
      "Bash(/Users/pmayank/workspace/LdcDemo/.venv/bin/python /Users/pmayank/workspace/LdcDemo/.claude/hooks/protect_secrets.py)"
    ]
  }
}
